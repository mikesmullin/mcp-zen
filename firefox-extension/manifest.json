{
  "manifest_version": 2,
  "name": "mcp-zen",
  "version": "0.1.0",
  "description": "Lets a local mcp-zen MCP server remote-control this browser (tabs, navigation, page interaction).",
  "permissions": ["tabs", "storage", "webNavigation", "contextualIdentities"],
  "optional_permissions": ["<all_urls>", "cookies"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dist/console-hook.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "options_ui": {
    "page": "options.html"
  }
}
